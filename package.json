{
  "name": "synapz-music",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "description": "A Spotify-style music streaming desktop app with Discord Rich Presence.",
  "author": "crusheR-058",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "node scripts/export-catalog.mjs && vite build",
    "preview": "vite preview --port 4173",
    "electron": "electron .",
    "dev:electron": "concurrently -k -n web,shell -c cyan,green \"vite\" \"electron .\"",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run icons && vite build && electron-builder",
    "dist:win": "npm run icons && vite build && electron-builder --win",
    "dist:mac": "npm run icons && vite build && electron-builder --mac",
    "deploy": "vercel --prod",
    "deploy:watch": "node scripts/deploy-watch.mjs",
    "catalog": "node scripts/export-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.synapz.music",
    "productName": "Synapz Music",
    "asar": false,
    "afterPack": "scripts/adhoc-sign.cjs",
    "protocols": [
      {
        "name": "Synapz Music",
        "schemes": [
          "synapz"
        ]
      }
    ],
    "files": [
      "dist/**",
      "server/**",
      "lib/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "crusheR-058",
        "repo": "SynapzStudio"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Synapz Music"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
