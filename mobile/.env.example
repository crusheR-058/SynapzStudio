# Copy to .env and fill in. EXPO_PUBLIC_ is required — Expo only inlines
# variables with that prefix into the client bundle.
#
# Same values as the web build's VITE_* vars. The anon key is public-safe;
# Row-Level Security is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where /api and /yt calls go. Mobile has no backend of its own, so this points
# at the deployed web app.
EXPO_PUBLIC_API_BASE=https://synapz-music.vercel.app
EXPO_PUBLIC_WEB_ORIGIN=https://synapz-music.vercel.app
