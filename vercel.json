{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/export-catalog.mjs && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/yt/:path*",
      "destination": "/api/yt/:path*"
    },
    {
      "source": "/listen/:code",
      "destination": "/"
    },
    {
      "source": "/play/:source/:id",
      "destination": "/"
    }
  ]
}
