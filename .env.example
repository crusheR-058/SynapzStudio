# Optional: real "Sign in with Google". Create an OAuth 2.0 Client ID (type
# "Web application") at https://console.cloud.google.com/apis/credentials and add
# http://localhost:5173 to "Authorized JavaScript origins". Paste the client id
# here. Without it, the Google button signs you in with a demo account.
VITE_GOOGLE_CLIENT_ID=

# Optional: YouTube Data API v3 key to unlock the full catalog (all Hindi /
# Bollywood songs, old & new) via YouTube search + the official IFrame player.
#
# You can also paste the key inside the app (Bollywood tab → "Connect YouTube"),
# which stores it in your browser's localStorage and needs no rebuild.
#
# How to get a key:
#   1. https://console.cloud.google.com/apis/library/youtube.googleapis.com  → Enable
#   2. APIs & Services → Credentials → Create credentials → API key
#   3. Copy it below, then copy this file to ".env" and restart `npm run dev`
VITE_YOUTUBE_API_KEY=

# Optional: Supabase cloud backend (accounts + synced likes/playlists/history).
# See SUPABASE.md for the 10-minute setup. The anon key is public/safe — your
# data is protected by Row-Level Security, not by hiding the key. NOT the
# service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
